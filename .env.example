NODE_ENV=production
FRONTEND_PORT=3100

POSTGRES_DB=personalink
POSTGRES_USER=personalink
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_HOST=postgres
DB_PORT=5432
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_SSL=0

PORT=3003
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ADMIN_INITIAL_PASSWORD=replace-before-the-first-start
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=1
AUTO_SEED=1
SEED_DEMO_USER=0
