PORT=3000
# Windows 与 Ubuntu 统一使用 SQLite；数据库是一个真实文件。
DATABASE_PATH=./var/blog.sqlite
MEDIA_PATH=./var/media
BACKUP_PATH=./var/backups
CONFIG_ENV_PATH=.env
# ============ TODO 04（中等）：生产环境的配置要单独一份 ============
# 本机开发和线上服务器用的是**两套完全不同的配置**：
#   本机：数据库在 ./var 下，密钥随便填，端口 3000
#   线上：数据库在持久化目录，密钥必须是真随机，端口由 Nginx 反代
#
# 终端里看得到的结果：服务器上 cat .env 能看到真实值，
# 而这个 .env.example 里永远是空的。
#
# TODO：把这两行说明补回去，并在**服务器上那份 .env** 里填真实值。
# 生成一个真随机密钥（32 字节转成 base64url，约 43 个字符）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# **这个文件是模板，永远不要往里填真实密钥。**
# 真实值只写在服务器上那份 .env 里，而 .env 在 .gitignore 里。
# 一旦真密钥进了 Git 历史，删掉也没用——**必须去作废重发**。
# ========================================================
# 在本机生成随机密钥后填写，至少32字符。
SESSION_SECRET=
# 首次建库时设置管理员账号；普通注册用户不填写此项。
ADMIN_USERNAME=
ADMIN_PASSWORD=
