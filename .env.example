PORT=3030
APP_ORIGINS=http://127.0.0.1:5173
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=8000
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=60000
VITE_API_BASE_URL=

# ---- MiniMax（v2.0 新增）----
# 真实密钥**只放在服务器的环境变量里**，永远不要写进这个文件、也不要提交。
# 本机开发：复制本文件为 .env，把下面这行填上自己的密钥。
# 线上：在 Netlify 的 Site configuration → Environment variables 里添加，勾选 Secret。
# 没有密钥也能跑：后端会自动退回本地文案库，产品照常可用。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
