PORT=3000
# Windows 与 Ubuntu 统一使用 SQLite；数据库是一个真实文件。
DATABASE_PATH=./var/blog.sqlite
MEDIA_PATH=./var/media
BACKUP_PATH=./var/backups
CONFIG_ENV_PATH=.env
# ============ 第11课 TODO 04（中等）：生产环境的配置要单独一份 ============
# （请补充）1：本机的数据库路径、密钥和端口应该怎样设置？
# （请补充）2：服务器的持久化目录、随机密钥和 Nginx 反代有什么不同？
# 只补上面两行注释；真实密钥只能写进被 .gitignore 忽略的 .env。
# ======================================================================
# 在本机生成随机密钥后填写，至少32字符。
SESSION_SECRET=
# 首次建库时设置管理员账号；普通注册用户不填写此项。
ADMIN_USERNAME=
ADMIN_PASSWORD=
