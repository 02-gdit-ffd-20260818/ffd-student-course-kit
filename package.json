{
  "name": "ffd-p4-greeting-card",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "start:api": "node --env-file-if-exists=.env server/index.js",
    "check": "node scripts/check-project.mjs && node scripts/check-contrast.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:component": "vitest run tests/theme.component.test.js tests/share.component.test.js",
    "test": "npm run test:unit && npm run test:component",
    "build": "vite build",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "express": "^5.2.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
