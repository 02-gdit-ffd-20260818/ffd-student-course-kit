{
    "name":  "ffd-p2-blog",
    "version":  "2.3.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=24"
                },
    "scripts":  {
                    "dev":  "vite",
                    "dev:api":  "node --env-file-if-exists=.env --watch server/index.js",
                    "start:api":  "node --env-file-if-exists=.env server/index.js",
                    "db:migrate":  "node database/migrate.mjs",
                    "db:seed":  "node database/seed.mjs",
                    "db:verify":  "node database/verify.mjs",
                    "db:backup":  "node database/backup.mjs",
                    "db:restore":  "node database/restore.mjs",
                    "check":  "node scripts/check-project.mjs",
                    "test:unit":  "node --test tests/*.test.mjs",
                    "test:component":  "vitest run",
                    "test":  "npm run test:unit \u0026\u0026 npm run test:component",
                    "build":  "vite build"
                },
    "dependencies":  {
                         "express":  "^5.1.0",
                         "pinia":  "^3.0.0",
                         "vue":  "^3.5.0",
                         "vue-router":  "^4.5.0"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-vue":  "^6.0.0",
                            "vite":  "^7.0.0",
                            "vitest":  "^3.0.0"
                        }
}
