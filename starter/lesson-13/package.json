{
  "name": "ffd-p3-community",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "start:api": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node database/migrate.mjs",
    "db:mysql:migrate": "node database/mysql/migrate.mjs",
    "db:mysql:verify": "node database/mysql/verify.mjs",
    "db:mysql:backup": "node database/mysql/backup.mjs",
    "db:mysql:restore": "node database/mysql/restore.mjs",
    "check": "node scripts/check-project.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:component": "vitest run",
    "test": "npm run test:unit && npm run test:component",
    "build": "vite build"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "mysql2": "^3.24.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
